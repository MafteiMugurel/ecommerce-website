{
  "name": "ecommerce-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "check": "npm run lint && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "npm run build && firebase deploy --only hosting,firestore:rules",
    "release": "npm run lint && npm run test:e2e && npm run build && firebase deploy --only hosting,firestore:rules",
    "seed": "node scripts/seed.mjs",
    "create-user": "node scripts/create-user.mjs",
    "update-images": "node scripts/update-images.mjs",
    "seed-demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "firebase": "^13.3.0",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
