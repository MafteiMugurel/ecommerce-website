rules_version = '2';

// ⚠ REGULI TEMPORARE – doar pentru `npm run seed`.
// Permit oricui să scrie în catalog. După import, publică imediat firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{id} {
      allow read, write: if true;
    }
    match /products/{id} {
      allow read, write: if true;
    }
    match /reviews/{id} {
      allow read, write: if true;
    }
  }
}
