rules_version = '2';

// Regulile de securitate Firestore pentru IT Shop.
// Se publică din consola Firebase (Firestore Database → Rules) sau cu
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Un utilizator e admin dacă există documentul admins/{uid}.
    // Documentele din "admins" se creează DOAR din consola Firebase.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Lista de administratori: fiecare își poate verifica propriul rol, nimeni nu scrie din aplicație.
    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Catalog: oricine citește; doar adminii scriu.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un produs valid: doar câmpurile cunoscute, preț pozitiv, stoc întreg >= 0.
    // Se verifică documentul complet după scriere, deci și la modificarea doar a stocului.
    function validProduct(data) {
      return data.keys().hasOnly(['name', 'brand', 'description', 'price', 'currency', 'category',
                                  'imageUrl', 'imageCredit', 'stock', 'rating', 'specs', 'createdAt'])
        && isString(data.name, 1, 200)
        && isString(data.brand, 1, 80)
        && isString(data.description, 1, 1000)
        && isString(data.category, 1, 80)
        && data.price is number && data.price > 0
        && data.stock is int && data.stock >= 0
        && data.imageUrl is string
        && data.specs is list && data.specs.size() <= 50
        && (!('imageCredit' in data) || data.imageCredit is map);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Recenzii: oricine citește; utilizatorii autentificați scriu în numele lor; adminii pot șterge.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['productId', 'userId', 'author', 'rating', 'comment', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && isString(request.resource.data.author, 1, 40)
        && isString(request.resource.data.comment, 1, 1000)
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Adresa de livrare: toate câmpurile obligatorii, cu lungimi limitate.
    function validShipping(s) {
      return s is map
        && s.keys().hasOnly(['name', 'phone', 'email', 'county', 'city', 'address'])
        && isString(s.name, 3, 100)
        && isString(s.phone, 9, 20)
        && isString(s.email, 3, 200)
        && isString(s.county, 2, 40)
        && isString(s.city, 2, 100)
        && isString(s.address, 5, 200);
    }

    // Comenzi:
    //  - oricine plasează o comandă nouă (și fără cont), cu statusul "placed",
    //    adresă de livrare completă și o metodă de plată cunoscută;
    //  - clientul autentificat își citește doar comenzile proprii;
    //  - adminii văd și gestionează toate comenzile.
    match /orders/{orderId} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['userId', 'items', 'totalItems', 'totalPrice', 'status',
                                              'shipping', 'paymentMethod', 'createdAt'])
        && (request.resource.data.userId == null
            || (signedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.status == 'placed'
        && validShipping(request.resource.data.shipping)
        && request.resource.data.paymentMethod in ['card', 'card_on_delivery', 'cash_on_delivery', 'bank_transfer']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice > 0
      );
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Mesaje din formularul de contact: oricine trimite, doar adminii citesc.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
        && isString(request.resource.data.name, 1, 100)
        && isString(request.resource.data.email, 3, 200)
        && isString(request.resource.data.subject, 1, 200)
        && isString(request.resource.data.message, 1, 5000);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Profilul utilizatorului (nume, email, favorite): proprietarul îl citește și îl scrie;
    // adminii îl pot citi (pentru statistici).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'favoriteIds'])
        && (!('favoriteIds' in request.resource.data)
            || (request.resource.data.favoriteIds is list && request.resource.data.favoriteIds.size() <= 500));
      allow delete: if false;
    }
  }
}
